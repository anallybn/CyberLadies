# Exemplo sem credenciais. Copie para .env SOMENTE no servidor autorizado.
# Domínio real apontando por DNS para esse servidor; sem https:// e sem caminho.
APP_DOMAIN=
DATABASE_USER=cyberladies_app
DATABASE_PASSWORD=
# Mesmo domínio com /api: deixe vazio. Vercel externa: origem HTTPS exata, sem / final.
APP_CORS_ORIGINS=
